generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         Role       @default(USER)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  incidents    Incident[]
}

model Incident {
  id          String   @id @default(cuid())
  title       String
  description String
  severity    Severity
  status      Status   @default(OPEN)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  resolvedAt  DateTime?
  createdBy   User     @relation(fields: [createdById], references: [id])
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Status {
  OPEN
  RESOLVED
}

enum Role {
  USER
  ADMIN
}
